# TalentPilot AI — Environment Configuration Example

# Security & Sessions
SECRET_KEY=talentpilot-super-secret-production-key-2026-hackathon
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_EXPIRE_HOURS=72

# Database (SQLite for local zero-configuration, PostgreSQL for managed production)
DATABASE_URL=sqlite:///./talentpilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/talentpilot

# Gemini AI (Optional: System operates with intelligent deterministic failover if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# Candidate Portal Origin URL
APP_ORIGIN=http://127.0.0.1:8000

# Gmail SMTP Configuration for Real Automated Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=TalentPilot AI
DEFAULT_EVALUATION_EMAIL=your_email@gmail.com
